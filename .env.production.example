# Scout SaaS production env template. Copy to .env.production and fill values.
# Never commit real secrets. Stripe price IDs from /.stripe-credentials-and-price-id.md only.

SCOUT_DB_PASSWORD=change-me
DATABASE_URL=postgresql://scout:change-me@scout-saas-postgres:5432/scout
REDIS_URL=redis://scout-saas-redis:6379

SCOUT_JWT_SECRET=change-me-jwt
SCOUT_API_KEY=change-me-internal-key

DASHBOARD_ORIGIN=https://console.labyrinthscout.com
NEXT_PUBLIC_SCOUT_API_URL=https://console.labyrinthscout.com

# Stripe (test mode first). Do not create new prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONITOR_PRICE_ID=price_1TqyO52WMXleLh8eOoMSRO5a
STRIPE_GOVERN_PRICE_ID=price_1TqyQ02WMXleLh8eAVQHwiRo
STRIPE_TEAM_PRICE_ID=price_1TqyQn2WMXleLh8eUqmCs1Oq
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# E2E only (never enable in real production):
# SCOUT_E2E_ALLOW_PLAN_OVERRIDE=true

# On-chain agent identity (optional). Both must be set or the engine skips
# the chain write after verifying the agent's signature. See scout-chain/README.md
# and scout-engine/.env.example. Never commit the operator private key.
# SCOUT_CHAIN_CONTRACT_ADDRESS=
# SCOUT_CHAIN_OPERATOR_PRIVATE_KEY=
# SCOUT_CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# SCOUT_CHAIN_EXPLORER_BASE=https://sepolia.etherscan.io

# Governance HTTP is set in docker-compose.prod.yml (SCOUT_GOVERNANCE_API_URL).
# The governance database name and TLS paths are also compose settings, not
# variables in this file. See deploy/README.md.
