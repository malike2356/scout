# Edge nginx snippet for Scout SaaS pilot on console.labyrinthscout.com
# Merge into the Carina / host nginx that already terminates TLS for this host.
# Containers (on Docker network `proxy`):
#   scout-saas-dashboard:3005
#   scout-saas-engine:4444
#
# Same-host API avoids CORS for browser dashboard calls.

upstream scout_saas_dashboard {
    server scout-saas-dashboard:3005;
}

upstream scout_saas_engine {
    server scout-saas-engine:4444;
}

server {
    server_name console.labyrinthscout.com;

    # Public API + dashboard API + Stripe webhook -> engine
    location /v1/ {
        proxy_pass http://scout_saas_engine;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://scout_saas_engine;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /webhooks/ {
        proxy_pass http://scout_saas_engine;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass http://scout_saas_engine/health;
        proxy_set_header Host $host;
    }

    # Customer UI -> Next dashboard
    location / {
        proxy_pass http://scout_saas_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
