# Copy to .env. Never commit .env.

# Generated by `pnpm generate-wallet` - do not hand-write this.
SCOUT_CHAIN_OPERATOR_PRIVATE_KEY=

# Public RPC endpoint; no API key required. Override with your own
# Infura/Alchemy URL if the public endpoint is rate-limited.
SCOUT_CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Filled in by `pnpm deploy:sepolia` after a successful deployment.
SCOUT_CHAIN_CONTRACT_ADDRESS=
