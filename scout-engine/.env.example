# Labyrinth Scout - Standalone Engine
# Copy to .env and fill in real values. Never commit .env.

# Server
SCOUT_PORT=4444
SCOUT_ENV=development

# Database (standalone Postgres from docker-compose; not Carina's DB)
SCOUT_DATABASE_URL=postgresql://scout:scout@localhost:5433/scout
DATABASE_URL=postgresql://scout:scout@localhost:5433/scout
DB_HOST=localhost
DB_PORT=5433
DB_USER=scout
DB_PASSWORD=scout
DB_NAME=scout

# Redis (standalone; docker-compose maps host 6380 -> 6379)
REDIS_URL=redis://localhost:6380

# Auth
SCOUT_API_KEY=change-me-in-production
# SCOUT_API_KEYS=key-one,key-two
SCOUT_JWT_SECRET=change-me-jwt-secret
# SCOUT_AUTH_DISABLED=true
# SCOUT_API_RATE_LIMIT=100
# SCOUT_DEFAULT_TIMEZONE=Europe/London

# Optional: Carina model access (Scout calls Carina, not the reverse)
# CARINA_API_URL=http://localhost:3000

# Keprix runtime target (C04 Scout-Keprix connector)
# KEPRIX_URL=http://127.0.0.1:3333
# KEPRIX_SCOUT_KILL_TOKEN=
# CARINA_KEPRIX_SHARED_TOKEN=
# SCOUT_TARGETS_CONFIG=./config/targets.yaml

# Optional alert webhook (WhatsApp/Telegram bridge, etc.)
# ALERT_WEBHOOK_URL=

# Optional static dashboard path (defaults to ./public if present)
# SCOUT_DASHBOARD_STATIC_PATH=./public

# Carina integration: point LABYRINTH_URL / SCOUT_API_URL at this engine
# Example for Carina: LABYRINTH_URL=http://localhost:4444
# Operator-generated org key for Carina (after Prompt 2 migrations):
# SCOUT_CARINA_ORG_API_KEY=

# Stripe (Prompt 5; never commit live secrets)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MONITOR_PRICE_ID=price_1TqyO52WMXleLh8eOoMSRO5a
# STRIPE_GOVERN_PRICE_ID=price_1TqyQ02WMXleLh8eAVQHwiRo
# STRIPE_TEAM_PRICE_ID=price_1TqyQn2WMXleLh8eUqmCs1Oq
